          "allowGenericChildren": true
        }
      ],
      "agentRoutingMode": "assigned",
      "outputs": [
        {
          "outputId": "custom-grammars-batch-two",
          "description": "Bundled .xshd grammars for Go, Rust, Bash, and Markdown registered with the picker, highlighting engine, and theme palette hook."
        }
      ],
      "inputs": [
        "highlighting-engine",
        "theme-palette-hook"
      ],
