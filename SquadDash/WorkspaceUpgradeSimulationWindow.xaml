<Window x:Class="SquadDash.WorkspaceUpgradeSimulationWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SquadDash"
        Title="Workspace Upgrade Panel Simulation"
        Width="960"
        Height="740"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppSurface}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PanelSurface}"
                BorderBrush="{DynamicResource InputBorder}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Developer simulation for the workspace-upgrade dry-run summary panel."
                           Foreground="{DynamicResource LabelText}"
                           Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Preview state:"
                               Foreground="{DynamicResource LabelText}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="StateComboBox"
                              Width="240"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              SelectionChanged="StateComboBox_SelectionChanged">
                        <ComboBoxItem Tag="Idle" Content="Idle" IsSelected="True" />
                        <ComboBoxItem Tag="Running" Content="Running" />
                        <ComboBoxItem Tag="Succeeded" Content="Succeeded" />
                        <ComboBoxItem Tag="Failed" Content="Failed" />
                        <ComboBoxItem Tag="PartiallyApplied" Content="PartiallyApplied" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <local:WorkspaceUpgradeSummaryPanel x:Name="SummaryPanel"
                                            Grid.Row="1" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Close"
                    Style="{StaticResource ThemedButtonStyle}"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
