<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="Rust"
                  extensions=".rs"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" foreground="#174EA6" />
  <Color name="Comment" foreground="#426536" />
  <Color name="String" foreground="#8F3520" />
  <Color name="Number" foreground="#6841A5" />
  <Color name="Type" foreground="#00695C" />
  <Color name="Method" foreground="#795B00" />
  <Color name="Punctuation" foreground="#493827" />

  <RuleSet name="BlockComment">
    <Span color="Comment" begin="/\*" end="\*/" multiline="true" ruleSet="BlockComment" />
  </RuleSet>

  <RuleSet>
    <Span color="Comment" begin="//" />
    <Span color="Comment" begin="/\*" end="\*/" multiline="true" ruleSet="BlockComment" />

    <Span color="String" begin="(?&lt;![\w'])b?'(?:\\(?:u\{[0-9A-Fa-f_]+\}|x[0-9A-Fa-f]{2}|.)|[^\\'\r\n])'" end="" />
    <Span color="String" begin="&quot;" end="&quot;" multiline="true">
      <RuleSet>
        <Span color="Punctuation" begin="\\" end="." />
      </RuleSet>
    </Span>
    <Span color="String" begin="r&quot;" end="&quot;" multiline="true" />
    <Span color="String" begin="r\#&quot;" end="&quot;\#" multiline="true" />
    <Span color="String" begin="r\#\#&quot;" end="&quot;\#\#" multiline="true" />
    <Span color="String" begin="r\#\#\#&quot;" end="&quot;\#\#\#" multiline="true" />
    <Span color="String" begin="br&quot;" end="&quot;" multiline="true" />
    <Span color="String" begin="br\#&quot;" end="&quot;\#" multiline="true" />
    <Span color="String" begin="br\#\#&quot;" end="&quot;\#\#" multiline="true" />
    <Span color="String" begin="br\#\#\#&quot;" end="&quot;\#\#\#" multiline="true" />

    <Rule color="Number">\b(?:0[xX][0-9A-Fa-f_]+|0[oO][0-7_]+|0[bB][01_]+|\d[\d_]*(?:\.\d[\d_]*)?(?:[eE][+\-]?\d[\d_]*)?)(?:u8|u16|u32|u64|u128|usize|i8|i16|i32|i64|i128|isize|f32|f64)?\b</Rule>
    <Rule color="Method">\b[A-Za-z_][A-Za-z0-9_]*!</Rule>
    <Rule color="Punctuation">::|-&gt;|=&gt;|[{}\[\]().,;:+\-*/%&amp;|^!&lt;&gt;=?]</Rule>

    <Keywords color="Keyword">
      <Word>as</Word><Word>async</Word><Word>await</Word><Word>break</Word><Word>const</Word>
      <Word>continue</Word><Word>crate</Word><Word>dyn</Word><Word>else</Word><Word>enum</Word>
      <Word>extern</Word><Word>false</Word><Word>fn</Word><Word>for</Word><Word>if</Word>
      <Word>impl</Word><Word>in</Word><Word>let</Word><Word>loop</Word><Word>match</Word>
      <Word>mod</Word><Word>move</Word><Word>mut</Word><Word>pub</Word><Word>ref</Word>
      <Word>return</Word><Word>self</Word><Word>Self</Word><Word>static</Word><Word>struct</Word>
      <Word>super</Word><Word>trait</Word><Word>true</Word><Word>type</Word><Word>unsafe</Word>
      <Word>use</Word><Word>where</Word><Word>while</Word>
    </Keywords>

    <Keywords color="Type">
      <Word>bool</Word><Word>char</Word><Word>str</Word><Word>String</Word>
      <Word>i8</Word><Word>i16</Word><Word>i32</Word><Word>i64</Word><Word>i128</Word><Word>isize</Word>
      <Word>u8</Word><Word>u16</Word><Word>u32</Word><Word>u64</Word><Word>u128</Word><Word>usize</Word>
      <Word>f32</Word><Word>f64</Word>
      <Word>Option</Word><Word>Result</Word><Word>Vec</Word>
    </Keywords>
    <Rule color="Method">\b[A-Za-z_][A-Za-z0-9_]*\b(?=\s*\()</Rule>
  </RuleSet>
</SyntaxDefinition>
