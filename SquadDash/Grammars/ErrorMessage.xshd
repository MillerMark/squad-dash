<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="Error message"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Method" />
  <Color name="Time" />
  <Color name="MonthDay" />
  <Color name="FileName" />
  <Color name="LineNumber" />
  <Color name="Message" />
  <Color name="ExceptionType" />
  <Color name="Subtle" />

  <RuleSet name="ExceptionTypes">
    <Rule color="ExceptionType">\b\p{Lu}[\p{L}\p{N}_]*Exception\b</Rule>
  </RuleSet>

  <RuleSet>
    <Span multiline="false">
      <Begin>^[ \t]+(?=at[ \t]+(?:[\p{L}_$][\p{L}\p{N}_$]*(?:\.[\p{L}_$][\p{L}\p{N}_$]*)*/)?(?:[\p{L}_&lt;&gt;$][\p{L}\p{N}_&lt;&gt;`$+|,\[\]-]*(?&lt;!&lt;)\.)+\.?[\p{L}_&lt;&gt;$][\p{L}\p{N}_&lt;&gt;`$+|,.\[\]-]*\([^\r\n()]*\)(?:[ \t]+in[ \t]+[^ \t\r\n][^\r\n]*:line[ \t]+[0-9]+)?[ \t]*$)</Begin>
      <RuleSet>
        <Rule color="Subtle">at(?=[ \t]+)</Rule>
        <!-- Keep the qualified prefix neutral without consuming the dot inside &lt;.ctor&gt;. -->
        <Rule>[ \t]+(?:[\p{L}_$][\p{L}\p{N}_$]*(?:\.[\p{L}_$][\p{L}\p{N}_$]*)*/)?(?:[\p{L}_&lt;&gt;$][\p{L}\p{N}_&lt;&gt;`$+|,\[\]-]*(?&lt;!&lt;)\.)+\.?</Rule>
        <Rule color="Method">[\p{L}_&lt;&gt;$][\p{L}\p{N}_&lt;&gt;`$+|,.\[\]-]*</Rule>
        <Span multiline="false">
          <Begin color="Subtle">\(</Begin>
          <End color="Subtle">\)</End>
        </Span>
        <Span multiline="false">
          <Begin color="Subtle">\bin(?=[ \t]+)</Begin>
          <RuleSet>
            <Rule>[ \t]+(?:[^\r\n]*[\\/])?</Rule>
            <Rule color="FileName">[^\\/\r\n:]+</Rule>
            <Span multiline="false">
              <Begin color="Subtle">:line(?=[ \t]+)</Begin>
              <RuleSet>
                <Rule color="LineNumber">[0-9]+</Rule>
              </RuleSet>
            </Span>
          </RuleSet>
        </Span>
      </RuleSet>
    </Span>

    <Span multiline="false">
      <Begin>^[ \t]*(?:(?:Operation|Occurred):[ \t]+)?[0-9]{4}(?=-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})?(?:[ \t]|$))</Begin>
      <End>(?=[ \t]|$)</End>
      <RuleSet>
        <Rule color="Subtle">-</Rule>
        <Rule color="MonthDay">[0-9]{2}-[0-9]{2}</Rule>
        <Span multiline="false">
          <Begin color="Subtle">T</Begin>
          <End>(?=[ \t]|$)</End>
          <RuleSet>
            <Rule color="Time">[0-9]{2}:[0-9]{2}:[0-9]{2}</Rule>
            <Rule color="Subtle">\.[0-9]+(?:Z|[+-][0-9]{2}:[0-9]{2})?|Z|[+-][0-9]{2}:[0-9]{2}</Rule>
          </RuleSet>
        </Span>
      </RuleSet>
    </Span>

    <Span multiline="false">
      <Begin>^[ \t]*(?:(?:---&gt;|Caused[ ]by:|Exception[ ]in[ ]thread[ ]"[^"\r\n]+")[ \t]+)?(?=(?:[\p{L}_][\p{L}\p{N}_`]*[.+])*(?:[\p{L}_][\p{L}\p{N}_`]*Exception|Exception):)</Begin>
      <RuleSet>
        <Import ruleSet="ExceptionTypes" />
        <Span multiline="false">
          <Begin>:[ \t]*</Begin>
          <RuleSet>
            <Rule color="Message">[^\r\n]+</Rule>
          </RuleSet>
        </Span>
      </RuleSet>
    </Span>
    <Import ruleSet="ExceptionTypes" />
  </RuleSet>
</SyntaxDefinition>
