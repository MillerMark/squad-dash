<UserControl x:Class="SquadDash.WorkspaceUpgradeSummaryPanel"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="WorkspaceUpgradeSummaryPanel_Loaded"
             KeyboardNavigation.TabNavigation="Continue">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelSurface}"
            BorderBrush="{DynamicResource InputBorder}"
            BorderThickness="1"
            Padding="12"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding PanelTitle}"
                       Foreground="{DynamicResource ImportantText}"
                       FontSize="{DynamicResource FontSizeSubtitle}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <Border Grid.Row="1"
                    Background="{DynamicResource InputSurface}"
                    BorderBrush="{DynamicResource InputBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding StateMessage}"
                               Foreground="{DynamicResource LabelText}"
                               FontSize="{DynamicResource FontSizeBody}" />
                    <ProgressBar IsIndeterminate="True"
                                 Height="6"
                                 Margin="0,8,0,0"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource AlertBodyText}"
                               FontSize="{DynamicResource FontSizeBody}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <TextBlock Text="Select a file to compare its current content with the incoming Squad template. Template-level previews are identified when Squad performs additional workspace-specific rendering during apply."
                           Foreground="{DynamicResource BodyText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           Visibility="{Binding IsDryRunSummaryVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Border Background="{DynamicResource CardSurface}"
                        BorderBrush="{DynamicResource InputBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10"
                        Margin="0,0,0,10"
                        Visibility="{Binding IsSucceeded, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="The workspace-managed files were updated. This operation is complete; close this window when you are finished reviewing the applied changes."
                               Foreground="{DynamicResource BodyText}"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsDryRunSummaryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <Border Style="{StaticResource SectionBorderStyle}"
                            AutomationProperties.AutomationId="WorkspaceUpgradeSafeFilesSection"
                            AutomationProperties.Name="Safe additions and refreshes section">
                        <StackPanel>
                            <TextBlock Text="Safe additions/refreshes (non-destructive files)"
                                       Foreground="{DynamicResource LabelText}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding SafeAdditionsOrRefreshes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="{DynamicResource BodyText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,4">
                                            <Hyperlink Click="SafeFileLink_Click"
                                                       ToolTip="Preview current and proposed content">
                                                <Run Text="{Binding Path=., Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="(none)"
                                       Foreground="{DynamicResource SubtleText}"
                                       Visibility="{Binding IsSafeAdditionsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionBorderStyle}"
                            AutomationProperties.AutomationId="WorkspaceUpgradeTrackedChangesSection"
                            AutomationProperties.Name="Tracked local changes at risk section">
                        <StackPanel>
                            <TextBlock Text="Tracked-local-changes at risk (would be overwritten)"
                                       Foreground="{DynamicResource LabelText}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding TrackedLocalChangesAtRisk}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="{DynamicResource BodyText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,4">
                                            <Hyperlink Click="TrackedFileLink_Click"
                                                       ToolTip="Preview changes that would overwrite this customized file">
                                                <Run Text="{Binding Path=., Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="(none)"
                                       Foreground="{DynamicResource SubtleText}"
                                       Visibility="{Binding IsTrackedChangesEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionBorderStyle}"
                            AutomationProperties.AutomationId="WorkspaceUpgradeGeneratedFilesSection"
                            AutomationProperties.Name="Generated files at risk section">
                        <StackPanel>
                            <TextBlock Text="Generated files at risk (would be replaced)"
                                       Foreground="{DynamicResource LabelText}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding GeneratedFilesAtRisk}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="{DynamicResource BodyText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,4">
                                            <Hyperlink Click="GeneratedFileLink_Click"
                                                       ToolTip="Preview generated content that would replace this file">
                                                <Run Text="{Binding Path=., Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="(none)"
                                       Foreground="{DynamicResource SubtleText}"
                                       Visibility="{Binding IsGeneratedFilesEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionBorderStyle}"
                            Visibility="{Binding IsPartiallyApplied, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.AutomationId="WorkspaceUpgradePartialFilesSection"
                            AutomationProperties.Name="Partially applied files section">
                        <StackPanel>
                            <TextBlock Text="Partially applied files"
                                       Foreground="{DynamicResource LabelText}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding PartiallyAppliedFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{DynamicResource BodyText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="(none)"
                                       Foreground="{DynamicResource SubtleText}"
                                       Visibility="{Binding IsPartiallyAppliedFilesEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button x:Name="ApplyWorkspaceUpdateButton"
                        Content="Apply Workspace Update"
                        Style="{StaticResource ThemedButtonStyle}"
                        Margin="0,0,8,0"
                        TabIndex="0"
                        IsEnabled="{Binding IsApplyButtonEnabled}"
                        Visibility="{Binding IsApplyButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="WorkspaceUpgradeApplyButton"
                        AutomationProperties.Name="Apply Workspace Update"
                        Click="ApplyWorkspaceUpdateButton_Click" />
                <Button x:Name="DismissButton"
                        Content="{Binding DismissButtonLabel}"
                        Style="{StaticResource ThemedButtonStyle}"
                        TabIndex="1"
                        IsEnabled="{Binding IsActionButtonsEnabled}"
                        AutomationProperties.AutomationId="WorkspaceUpgradeLaterButton"
                        AutomationProperties.Name="{Binding DismissButtonLabel}"
                        Click="LaterButton_Click" />
            </StackPanel>
            <TextBlock Grid.Row="5"
                       Text="{Binding ApplyUnavailableExplanation}"
                       Foreground="{DynamicResource AlertBodyText}"
                       Margin="0,8,0,0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsApplyUnavailable, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
    </Border>
</UserControl>
